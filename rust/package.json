{
  "name": "@garursaili/core",
  "version": "1.4.0",
  "description": "Native Rust core for GarurSaili-CSS — the semantic Indian CSS framework",
  "license": "MIT",
  "author": {
    "name": "Barshan Sarkar",
    "location": "Malda, West Bengal, India"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "garur_core",
    "packageName": "@garursaili",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}